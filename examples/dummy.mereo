include "../linux.mereo"

-- Two ideas at once. A call names its OUT-ports in a second list, the other
-- way round -- the caller's name on the left, because that is the one being
-- assigned. And a name that already exists gains a FIELD where it is first
-- needed: the count belongs to the buffer, so it is written there rather than
-- declared at the top as a slot whose only job is to catch a result.

program goes
  buffer is 4096 bytes

  input is linux.file (
    path is "lorem_ipsum.txt",
    flags is 0,
    mode is 0
  )

  output is already linux.file (
    descriptor is 1
  )

  input.read (
    buffer is buffer,
    capacity is buffer.base_size
  ) (
    buffer.count is count
  )

  output.write (
    buffer is buffer,
    count is buffer.count
  )
end
