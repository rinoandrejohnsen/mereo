include "../linux.mereo"

-- Server demo: bind a TCP socket, listen, then loop, accepting connections,
-- reading what each client sends, and writing it to the terminal. The socket is
-- linux.mereo's `socket`, which is the same resource the client half uses --
-- what makes this one a server is which methods it calls.
--
-- `accept` hands back a new descriptor; `client is adopted linux.socket` takes
-- ownership, and because it is acquired inside the `serve goes` body it is
-- closed at the end of every iteration -- the loop is liveness-neutral. The
-- listening socket stays live across iterations; the tower closes it (and the
-- current client) only if a syscall faults and the server exits.
--
-- The bind address is linux.mereo's `sockaddr_in` laid over 16 bytes -- the
-- fields carry their own byte order, so there is no htons and no hex to check.

program goes
  capacity is 4096
  buffer is capacity bytes
  count is 0
  peer is -1

  host is 16 bytes
  bound is host as linux.sockaddr_in
  bound.family is 2                    -- AF_INET
  bound.port is 12346                  -- `2 bytes as big` -- network order, free
  bound.address is 2130706433          -- 127.0.0.1

  terminal is already linux.file (descriptor is 1)

  server is linux.socket (domain is 2, type is 1, protocol is 0)

  server.bind (address is host, length is host.size)

  server.listen (backlog is 1)

  serve goes
    server.accept (address is 0, length is 0, connection is peer)

    client is adopted linux.socket (descriptor is peer)

    client.read (buffer is buffer, capacity is capacity, count is count)

    terminal.write (buffer is buffer, count is count)

    repeat serve
  end
end
