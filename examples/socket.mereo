include "../linux.mereo"

-- Socket demo: connect a TCP socket to a local server, read the bytes it
-- sends, and write them to the terminal. The socket is linux.mereo's `socket`
-- -- one descriptor, opened by socket(2) and closed by the release tower on
-- every exit and every fault -- so this program declares no resource of its
-- own. It used to carry a `connection` resource written out here, and
-- server.mereo carried a second copy of the same thing.
--
-- The peer address is linux.mereo's `sockaddr_in` laid over 16 bytes. It used to
-- be spelled out as a hex string, with a comment explaining which fields were
-- network order -- the layout says that instead, and says it in one place.

program goes
  capacity is 4096
  buffer is capacity bytes
  count is 0
  written is 0

  host is 16 bytes
  peer is host as linux.sockaddr_in
  peer.family is 2                     -- AF_INET
  peer.port is 12345                   -- `2 bytes as big` -- network order, free
  peer.address is 2130706433           -- 127.0.0.1

  terminal is already linux.file (descriptor is 1)

  link is linux.socket (domain is 2, type is 1, protocol is 0)

  link.connect (address is host, length is host.size)

  link.read (buffer is buffer, capacity is capacity, count is count)

  terminal.write (buffer is buffer, count is count, written is written)

end
