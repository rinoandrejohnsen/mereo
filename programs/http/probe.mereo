include "../../linux.mereo"
include "../../core.mereo"
include "parse.mereo"

-- Read a request off stdin, parse it, and print what came out in a form a
-- script can compare against an oracle. Every span is printed as HEX, because
-- the inputs this is fed on purpose contain bytes that are not text.
--
--   R <result>                     always
--   V <minor>                      ...and these only when result >= 0
--   M <hex method>
--   P <hex path>
--   H <hex name> <hex value>       one per header, in order

program goes
  wire is 65536 bytes
  total is 0
  chunk is 0
  slots is 4096 bytes
  seen is 0
  body is 0
  used is 0
  where is 0
  page is 65536 bytes
  hexed is 65536 bytes
  hexlen is 0
  i is 0

  method is 0
  method_length is 0
  path is 0
  path_length is 0
  minor is 0

  input is already linux.file (descriptor is 0)
  gather goes
    input.read (buffer is wire + total, capacity is wire.size - total,
                count is chunk)
    leave gather when chunk == 0
    total is total + chunk
    repeat gather when total < wire.size
  end

  request.parse (data is wire, length is total,
                 line_limit is 8192,
                 method is method, method_length is method_length,
                 path is path, path_length is path_length, minor is minor,
                 body is body, slots is slots, limit is 128, count is seen, result is used)

  writer is already builder (data is page, count is 0, limit is 65536)
  writer.add (source is "R ", length is 2)
  writer.number (value is used)
  writer.byte (value is 10)

  used >= 0 goes

    writer.add (source is "V ", length is 2)
    writer.number (value is minor)
    writer.byte (value is 10)

    writer.add (source is "M ", length is 2)
    text.hexbytes (data is method, count is method_length,
                   buffer is hexed, length is hexlen)
    writer.add (source is hexed, length is hexlen)
    writer.byte (value is 10)

    writer.add (source is "P ", length is 2)
    text.hexbytes (data is path, count is path_length,
                   buffer is hexed, length is hexlen)
    writer.add (source is hexed, length is hexlen)
    writer.byte (value is 10)

    rows is already array (data is slots, count is seen, limit is 128,
                           stride is field.size)
    walk goes
      leave walk when i >= seen
      rows.at (index is i, address is where)
      one is [where : field.size] as field
      writer.add (source is "H ", length is 2)
      text.hexbytes (data is one.name, count is one.name_length,
                     buffer is hexed, length is hexlen)
      writer.add (source is hexed, length is hexlen)
      writer.byte (value is 32)
      text.hexbytes (data is one.value, count is one.value_length,
                     buffer is hexed, length is hexlen)
      writer.add (source is hexed, length is hexlen)
      writer.byte (value is 10)
      i is i + 1
      repeat walk
    end
  end

  screen is already linux.file (descriptor is 1)
  screen.write (buffer is page, count is writer.count)
end
