include "../../linux.mereo"
include "../../core.mereo"
include "parse.mereo"

-- Decode a chunked body on stdin and print what came out:
--
--   R <result>     the last result: -1 malformed, -2 wants more, else an offset
--   F <finished>   1 if the terminating chunk and trailer were seen
--   B <hex body>   every body byte the decoder handed back, in order

program goes
  wire is 65536 bytes
  wire.count is 0
  chunk is 0
  chunk_at is 0
  chunk_len is 0
  taken is 0
  taken_at is 0
  page is 65536 bytes
  hexed is 65536 bytes
  hexed.count is 0
  gathered is 65536 bytes
  gathered.count is 0

  at is 0
  finished is 0
  outcome is 0

  input is already linux.file (descriptor is 0)
  gather goes
    input.read (buffer is wire + wire.count, capacity is wire.size - wire.count,
                count is chunk)
    leave gather when chunk == 0
    wire.count is wire.count + chunk
    repeat gather when wire.count < wire.size
  end

  phase is 0
  remaining is 0

  drain goes
    chunked.step (data is wire, length is wire.count, offset is at,
                  phase is phase, remaining is remaining
    ) (
        chunk_at is body_offset,
        chunk_len is body_length,
        finished is finished,
        outcome is result
    )
    leave drain when outcome < 0
    taken is chunk_len
    taken_at is chunk_at
    text.copy (source is wire + taken_at, target is gathered + gathered.count,
               length is taken)
    gathered.count is gathered.count + taken
    at is outcome
    leave drain when finished == 1
    repeat drain
  end

  writer is already builder (data is page, count is 0, limit is 65536)
  writer.add (source is "R ", length is 2)
  writer.number (value is outcome)
  writer.byte (value is 10)
  writer.add (source is "F ", length is 2)
  writer.number (value is finished)
  writer.byte (value is 10)
  writer.add (source is "B ", length is 2)
  text.hexbytes (data is gathered, count is gathered.count, buffer is hexed) (hexed.count is length)
  writer.add (source is hexed, length is hexed.count)
  writer.byte (value is 10)

  screen is already linux.file (descriptor is 1)
  screen.write (buffer is page, count is writer.count)
end
