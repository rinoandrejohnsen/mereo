include "../../linux.mereo"
include "../../core.mereo"
include "parse.mereo"

-- Parse one request and print what came writer, one field per line. The request
-- is a literal here so the program is its own test; `serve.mereo` reads one
-- off a socket.

program goes
  slots is 2048 bytes
  seen is 0
  body is 0
  used is 0
  where is 0
  page is 4096 bytes

  wire is constant "GET /index.html?q=1 HTTP/1.1\r\nHost: example.com\r\nAccept:  text/html  \r\nEmpty:\r\n\r\n"

  method is 0
  method_length is 0
  path is 0
  path_length is 0
  minor is 0

  request.parse (data is wire, length is wire.size,
                 line_limit is 8192,
                 method is method, method_length is method_length,
                 path is path, path_length is path_length, minor is minor,
                 body is body, slots is slots, limit is 64, count is seen, result is used)

  ensure used >= 1

  writer is already builder (data is page, count is 0, limit is 4096)
  writer.add (source is method, length is method_length)
  writer.byte (value is 32)
  writer.add (source is path, length is path_length)
  writer.add (source is " HTTP/1.", length is 8)
  writer.number (value is minor)
  writer.byte (value is 10)

  rows is already array (data is slots, count is seen, limit is 64,
                         stride is field.size)
  i is 0
  walk goes
    leave walk when i >= seen
    rows.at (index is i, address is where)
    one is [where : field.size] as field
    writer.add (source is one.name, length is one.name_length)
    writer.add (source is " = [", length is 4)
    writer.add (source is one.value, length is one.value_length)
    writer.add (source is "]", length is 1)
    writer.byte (value is 10)
    i is i + 1
    repeat walk
  end

  writer.add (source is "bytes consumed: ", length is 16)
  writer.number (value is used)
  writer.byte (value is 10)

  screen is already linux.file (descriptor is 1)
  screen.write (buffer is page, count is writer.count)
end
