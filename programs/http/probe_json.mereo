include "../../linux.mereo"
include "../../core.mereo"
include "json.mereo"

-- Walk a JSON document on stdin and print every event, so a script can compare
-- it against an oracle:
--
--   E <kind> <depth> <hex key> <hex value>    one per event, in order
--   R <result>                                -1 malformed, -2 short, else the end

program goes
  wire is 65536 bytes
  total is 0
  chunk is 0
  page is 65536 bytes
  hexed is 65536 bytes
  hexlen is 0
  nest is 256 bytes

  depth is 0
  mode is 0
  at is 0
  outcome is 0
  kind is 0
  key_at is 0
  key_length is 0
  value_at is 0
  value_length is 0

  input is already linux.file (descriptor is 0)
  gather goes
    input.read (buffer is wire + total, capacity is wire.size - total,
                count is chunk)
    leave gather when chunk == 0
    total is total + chunk
    repeat gather when total < wire.size
  end

  writer is already builder (data is page, count is 0, limit is 65536)

  walk goes
    document.step (data is wire, length is total, offset is at,
                   stack is nest, depth_limit is 256,
                   depth is depth, mode is mode, kind is kind,
                   key_at is key_at, key_length is key_length,
                   value_at is value_at, value_length is value_length,
                   result is outcome)
    at is outcome
    leave walk when at < 0
    leave walk when kind == 0
    writer.add (source is "E ", length is 2)
    writer.number (value is kind)
    writer.byte (value is 32)
    writer.number (value is depth)
    writer.byte (value is 32)
    text.hexbytes (data is key_at, count is key_length, buffer is hexed,
                   length is hexlen)
    writer.add (source is hexed, length is hexlen)
    writer.byte (value is 32)
    text.hexbytes (data is value_at, count is value_length, buffer is hexed,
                   length is hexlen)
    writer.add (source is hexed, length is hexlen)
    writer.byte (value is 10)
    repeat walk
  end

  writer.add (source is "R ", length is 2)
  writer.number (value is outcome)
  writer.byte (value is 10)

  screen is already linux.file (descriptor is 1)
  screen.write (buffer is page, count is writer.count)
end
