include "../../linux.mereo"
include "../../core.mereo"
include "parse.mereo"

-- The response half of probe.mereo, in the same machine-readable form:
--
--   R <result>                     always
--   V <minor>                      ...and these only when result >= 0
--   S <status>
--   X <hex reason phrase>
--   H <hex name> <hex value>       one per header, in order

program goes
  wire is 65536 bytes
  wire.count is 0
  chunk is 0
  slots is 4096 bytes
  slots.count is 0
  body is 0
  used is 0
  where is 0
  page is 65536 bytes
  hexed is 65536 bytes
  hexed.count is 0
  i is 0

  minor is 0
  status is 0
  reason is 0
  reason_length is 0

  input is already linux.file (descriptor is 0)
  gather goes
    input.read (buffer is wire + wire.count, capacity is wire.size - wire.count,
                count is chunk)
    leave gather when chunk == 0
    wire.count is wire.count + chunk
    repeat gather when wire.count < wire.size
  end

  response.parse (data is wire, length is wire.count,
                  line_limit is 8192,
                  minor is minor, status is status,
                  reason is reason, reason_length is reason_length,
                  body is body, slots is slots, limit is 128, result is used)
                 (slots.count is count)

  writer is already builder (data is page, count is 0, limit is 65536)
  writer.add (source is "R ", length is 2)
  writer.number (value is used)
  writer.byte (value is 10)

  used >= 0 goes

    writer.add (source is "V ", length is 2)
    writer.number (value is minor)
    writer.byte (value is 10)

    writer.add (source is "S ", length is 2)
    writer.number (value is status)
    writer.byte (value is 10)

    writer.add (source is "X ", length is 2)
    text.hexbytes (data is reason, count is reason_length,
                   buffer is hexed) (hexed.count is length)
    writer.add (source is hexed, length is hexed.count)
    writer.byte (value is 10)

    rows is already array (data is slots, count is slots.count, limit is 128,
                           stride is field.size)
    walk goes
      leave walk when i >= slots.count
      rows.at (index is i, address is where)
      one is [where : field.size] as field
      writer.add (source is "H ", length is 2)
      text.hexbytes (data is one.name, count is one.name_length,
                     buffer is hexed) (hexed.count is length)
      writer.add (source is hexed, length is hexed.count)
      writer.byte (value is 32)
      text.hexbytes (data is one.value, count is one.value_length,
                     buffer is hexed) (hexed.count is length)
      writer.add (source is hexed, length is hexed.count)
      writer.byte (value is 10)
      i is i + 1
      repeat walk
    end
  end

  screen is already linux.file (descriptor is 1)
  screen.write (buffer is page, count is writer.count)
end
