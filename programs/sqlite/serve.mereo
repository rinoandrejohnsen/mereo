include "../../linux.mereo"
include "../../core.mereo"
include "../http/parse.mereo"
include "read.mereo"

blob is "demo.db" embedded

program goes
  wire is 16384 bytes
  page is 65536 bytes
  items is 32768 bytes
  parts is 32 bytes
  slots is 4096 bytes
  nest is 1024 bytes
  enable is 4 bytes

  -- what is left is what the program itself carries: the row cursor and its
  -- payload width, the schema search, the comma before every row but the
  -- first, and the header count `parse` accumulates. Everything else a call
  -- produces is named where the call produces it.
  slots.count is 0
  root is 0
  found is 0
  depth is 0
  payload_length is 0
  number is 0
  first is 0

  -- 1. open the database that is part of this binary
  db is already sqlite (
    data is blob, length is blob.size, page_size is 0,
    page_count is 0, encoding is 0, reserved_space is 0,
    read_version is 0
  )
  db.open () (outcome is result)

  ensure outcome == 0

  -- 2. find the `items` table by walking the schema, exactly as sqlite does
  depth is 1
  [nest : 8] is 1
  [nest + 8 : 8] is 0
  schema goes
    rows.step (
      data is blob, page_size is db.page_size, reserved is db.reserved_space,
      stack is nest, depth_limit is 64, depth is depth,
      payload_length is payload_length
    ) (
      rowid is rowid, payload_at is payload_at, got is result
    )

    leave schema when got != 1

    record.column (
      payload is payload_at, payload_length is payload_length, index is 1,
      number is number
    ) (
      at is at, kind is kind, size is size, ok is result
    )

    named goes
      leave named when ok != 0

      leave named when kind != 3

      text.equals (
        data is at, length is size, other is "items", other_length is 5
      ) (
        ok is result
      )

      leave named when ok != 1

      record.column (
        payload is payload_at, payload_length is payload_length, index is 3,
        number is number
      ) (
        at is at, kind is kind, size is size, ok is result
      )
      root is number when ok == 0
      found is 1 when ok == 0
    end  -- named

    leave schema when found == 1

    repeat schema
  end  -- schema

  ensure found == 1

  -- 3. serve it
  bound is linux.sockaddr_in (family is 2, port is 8080, address is 0)

  listener is linux.socket (domain is 2, type is 1, protocol is 0)

  [enable : 4] is 1

  listener.option (
    level is 1, name is 2, value is enable, length is 4
  ) (
    outcome is result
  )
  or continue (result is 0)

  listener.bind (address is bound, length is bound.size)

  listener.listen (backlog is 16)

  serve goes
    listener.accept (address is 0, length is 0) (peer is connection)

    client is adopted linux.socket (descriptor is peer)

    wire.count is 0
    client.read (buffer is wire, capacity is wire.size) (wire.count is count)

    request.parse (
      data is wire, length is wire.count, line_limit is 8192, slots is slots,
      limit is 64
    ) (
      slots.count is count,
      method_length is method_length, path_length is path_length,
      body is body, used is result, method is method, path is path,
      minor is minor
    )

    page is page as builder (count is 0, limit is page.size)

    items is items as builder (count is 0, limit is items.size)

    answer goes
      ok is 0

      used >= 0 goes
        text.equals (
          data is path, length is path_length, other is "/items",
          other_length is 6
        ) (
          ok is result
        )
      end  -- used >= 0

      ok == 0 goes
        page.add (source is "HTTP/1.1 404 Not Found\r\n", length is 24)
        page.add (source is "Content-Length: 0\r\n\r\n", length is 21)

        leave answer
      end  -- ok == 0

      -- the body first, so its length is known before the head is written
      items.byte (value is 91)
      first is 1
      depth is 1
      [nest : 8] is root
      [nest + 8 : 8] is 0

      listing goes
        rows.step (
          data is blob, page_size is db.page_size,
          reserved is db.reserved_space, stack is nest, depth_limit is 64,
          depth is depth, payload_length is payload_length
        ) (
          rowid is rowid, payload_at is payload_at, got is result
        )

        leave listing when got != 1

        first != 1 goes
          items.byte (value is 44)
        end  -- first != 1

        first is 0
        items.add (source is "{\"id\":", length is 6)
        items.number (value is rowid)
        items.add (source is ",\"name\":\"", length is 9)

        record.column (
          payload is payload_at, payload_length is payload_length,
          index is 1, number is number
        ) (
          at is at, kind is kind, size is size, ok is result
        )

        name_out goes
          leave name_out when ok != 0
          leave name_out when kind != 3
          items.add (source is at, length is size)
        end  -- name_out

        items.add (source is "\",\"qty\":", length is 8)
        record.column (
          payload is payload_at, payload_length is payload_length,
          index is 2, number is number
        ) (
          at is at, kind is kind, size is size, ok is result
        )
        items.number (value is number)
        items.byte (value is 125)

        repeat listing
      end  -- listing

      items.byte (value is 93)

      page.add (source is "HTTP/1.1 200 OK\r\n", length is 17)
      page.add (source is "Content-Type: application/json\r\n", length is 32)
      page.add (source is "Content-Length: ", length is 16)
      page.number (value is items.count)
      page.add (source is "\r\n\r\n", length is 4)
    end  -- answer

    -- write reponse

    head is parts as linux.iovec (base is page.data, length is page.count)
    rest is parts + 16 as linux.iovec (base is items.data, length is items.count)
    client.write_vectors (
      vectors is parts, count is 2, total is page.count + items.count
    ) (
      written is written
    )

    repeat serve
  end  -- serve
end  -- program
