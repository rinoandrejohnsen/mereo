include "../../linux.mereo"
include "../../core.mereo"
include "../http/parse.mereo"
include "read.mereo"

-- All three pieces in one program: an HTTP server that answers a REST request
-- with rows read out of a SQLite database CARRIED INSIDE THE BINARY.
--
--   $ curl localhost:8080/items
--   [{"id":1,"name":"alpha","qty":10},
--    {"id":2,"name":"beta","qty":20},
--    {"id":3,"name":"gamma","qty":30}]
--
-- There is no database file on disk, no allocator, and nothing is copied that
-- does not have to be. The request is parsed in the socket's own read buffer;
-- the table is found by walking the schema in .rodata; each row's text columns
-- are spans into .rodata that go straight into the response. The only bytes
-- that move are the ones written to the socket.
--
-- Each piece owns exactly what it should: `linux.socket` owns the descriptors
-- and the release tower closes them on every path, including a fault; the
-- three readers own nothing at all.

blob is "demo.db" embedded

program goes
  capacity is 16384
  wire is capacity bytes
  page is 65536 bytes
  answer_bytes is 32768 bytes
  slots is 4096 bytes
  nest is 1024 bytes
  host is 16 bytes

  total is 0
  peer is -1
  outcome is 0
  seen is 0
  used is 0
  written is 0

  method is 0
  method_length is 0
  path is 0
  path_length is 0
  minor is 0
  body is 0

  root is 0
  found is 0
  depth is 0
  got is 0
  rowid is 0
  payload_at is 0
  payload_length is 0
  index is 0
  kind is 0
  number is 0
  at is 0
  size is 0
  ok is 0
  first is 0

  -- 1. open the database that is part of this binary
  db is already sqlite (data is blob, length is blob.size, page_size is 0,
                        page_count is 0, encoding is 0, reserved_space is 0,
                        read_version is 0)
  db.open (result is outcome)
  ensure outcome == 0

  -- 2. find the `items` table by walking the schema, exactly as sqlite does
  depth is 1
  [nest : 8] is 1
  [nest + 8 : 8] is 0
  schema goes
    rows.step (data is blob, page_size is db.page_size,
               reserved is db.reserved_space, stack is nest,
               depth_limit is 64, depth is depth, rowid is rowid,
               payload_at is payload_at, payload_length is payload_length,
               result is got)
    leave schema when got != 1
    record.column (payload is payload_at, payload_length is payload_length,
                   index is 1, kind is kind, number is number,
                   at is at, size is size, result is ok)
    named goes
      leave named when ok != 0
      leave named when kind != 3
      text.equals (data is at, length is size, other is "items",
                   other_length is 5, result is ok)
      leave named when ok != 1
      record.column (payload is payload_at, payload_length is payload_length,
                     index is 3, kind is kind, number is number,
                     at is at, size is size, result is ok)
      root is number when ok == 0
      found is 1 when ok == 0
    end
    leave schema when found == 1
    repeat schema
  end
  ensure found == 1

  -- 3. serve it
  bound is host as linux.sockaddr_in
  bound.family is 2
  bound.port is 8080
  bound.address is 0

  listener is linux.socket (domain is 2, type is 1, protocol is 0)
  listener.option (level is 1, name is 2, value is host, length is 4,
                   result is outcome)
  or continue (result is 0)
  listener.bind (address is host, length is host.size)
  listener.listen (backlog is 16)

  serve goes
    listener.accept (address is 0, length is 0, connection is peer)
    client is adopted linux.socket (descriptor is peer)

    total is 0
    client.read (buffer is wire, capacity is capacity, count is total)

    request.parse (data is wire, length is total, line_limit is 8192,
                   method is method, method_length is method_length,
                   path is path, path_length is path_length, minor is minor,
                   slots is slots, limit is 64, count is seen,
                   body is body, result is used)

    writer is already builder (data is page, count is 0, limit is 65536)

    answer goes
      ok is 0
      route goes
        leave route when used < 0
        text.equals (data is path, length is path_length, other is "/items",
                     other_length is 6, result is ok)
      end

      missing goes
        leave missing when ok == 1
        writer.add (source is "HTTP/1.1 404 Not Found\r\n", length is 24)
        writer.add (source is "Content-Length: 0\r\n\r\n", length is 21)
        leave answer
      end

      -- the body first, so its length is known before the head is written
      rest is already builder (data is answer_bytes, count is 0, limit is 32768)
      rest.byte (value is 91)
      first is 1
      depth is 1
      [nest : 8] is root
      [nest + 8 : 8] is 0
      listing goes
        rows.step (data is blob, page_size is db.page_size,
                   reserved is db.reserved_space, stack is nest,
                   depth_limit is 64, depth is depth, rowid is rowid,
                   payload_at is payload_at, payload_length is payload_length,
                   result is got)
        leave listing when got != 1
        comma goes
          leave comma when first == 1
          rest.byte (value is 44)
        end
        first is 0
        rest.add (source is "{\"id\":", length is 6)
        rest.number (value is rowid)
        rest.add (source is ",\"name\":\"", length is 9)
        record.column (payload is payload_at, payload_length is payload_length,
                       index is 1, kind is kind, number is number,
                       at is at, size is size, result is ok)
        name_out goes
          leave name_out when ok != 0
          leave name_out when kind != 3
          rest.add (source is at, length is size)
        end
        rest.add (source is "\",\"qty\":", length is 8)
        record.column (payload is payload_at, payload_length is payload_length,
                       index is 2, kind is kind, number is number,
                       at is at, size is size, result is ok)
        rest.number (value is number)
        rest.byte (value is 125)
        repeat listing
      end
      rest.byte (value is 93)

      writer.add (source is "HTTP/1.1 200 OK\r\n", length is 17)
      writer.add (source is "Content-Type: application/json\r\n", length is 32)
      writer.add (source is "Content-Length: ", length is 16)
      writer.number (value is rest.count)
      writer.add (source is "\r\n\r\n", length is 4)
      writer.add (source is answer_bytes, length is rest.count)
    end

    client.write (buffer is page, count is writer.count, written is written)
    repeat serve
  end
end
