include "../../linux.mereo"

-- Phase-0 probe: drive the kernel crypto API (AF_ALG) to SHA-256 "abc" and
-- write the 32-byte digest to stdout. Proves mereo can build the sockaddr_alg,
-- open/bind/accept the transform, and feed it -- the backbone of TLS + kTLS.

transform is
  descriptor is -1
  status is 0

  acquire (domain, type, protocol) is
    linux.socket (domain is domain,
                  type is type,
                  protocol is protocol,
                  descriptor is descriptor)
  end

  attach (address, length) is
    linux.bind (descriptor is descriptor,
                address is address,
                length is length,
                result is status)
  end

  reap (accepted) is
    linux.accept (descriptor is descriptor,
                  address is 0,
                  length is 0,
                  connection is accepted)
  end

  release is
    linux.close (descriptor is descriptor)
  end
end

program is
  digest is 32 bytes
  count is 0
  written is 0
  peer is -1

  terminal is already linux.file (descriptor is 1)

  tfm is transform (domain is 38, type is 5, protocol is 0)

  tfm.attach (address is "&\x00hash\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00sha256\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
              length is 88)

  tfm.reap (accepted is peer)

  op is adopted linux.file (descriptor is peer)

  op.write (buffer is "abc", count is 3, written is written)

  op.read (buffer is digest, capacity is 32, count is count)

  terminal.write (buffer is digest, count is 32, written is written)

end
