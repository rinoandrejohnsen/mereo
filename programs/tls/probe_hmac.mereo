include "../../linux.mereo"

-- HMAC-SHA256 over AF_ALG: socket/bind(hmac(sha256))/setsockopt(ALG_SET_KEY)/
-- accept/write/read. Proves the keyed-hash path for the TLS key schedule.

transform is
  descriptor is -1
  status is 0

  acquire (domain, type, protocol) is
    linux.socket (domain is domain,
                  type is type,
                  protocol is protocol,
                  descriptor is descriptor)
  end

  attach (address, length) is
    linux.bind (descriptor is descriptor,
                address is address,
                length is length,
                result is status)
  end

  option (level, name, value, length) is
    linux.setsockopt (descriptor is descriptor,
                      level is level,
                      optname is name,
                      value is value,
                      length is length,
                      result is status)
  end

  reap (accepted) is
    linux.accept (descriptor is descriptor,
                  address is 0,
                  length is 0,
                  connection is accepted)
  end

  release is
    linux.close (descriptor is descriptor)
  end
end

program is
  keybuf is 8 bytes
  digest is 32 bytes
  count is 0
  written is 0
  peer is -1
  terminal is already linux.file (descriptor is 1)

  [keybuf + 0 : 1] is 107
  [keybuf + 1 : 1] is 101
  [keybuf + 2 : 1] is 121

  tfm is transform (domain is 38, type is 5, protocol is 0)

  tfm.attach (address is "&\x00hash\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00hmac(sha256)\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
              length is 88)

  tfm.option (level is 279, name is 1, value is keybuf, length is 3)

  tfm.reap (accepted is peer)

  op is adopted linux.file (descriptor is peer)

  op.write (buffer is "abc", count is 3, written is written)

  op.read (buffer is digest, capacity is 32, count is count)

  terminal.write (buffer is digest, count is 32, written is written)

end
