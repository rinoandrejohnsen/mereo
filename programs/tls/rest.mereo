include "client.mereo"

-- Fetch over HTTPS from a real server. No DNS (hardcoded IP) and no certificate
-- validation yet -- encrypted transport, unverified identity (like `curl -k`).
-- `secure_fetch` does the whole TLS 1.3 handshake, kTLS, and the exchange.
program is
  host is constant "example.com"
  request is constant "GET / HTTP/1.0\r\nHost: example.com\r\n\r\n"
  page is 16384 bytes
  got is 0

  terminal is already linux.file (descriptor is 1)

  endpoint is linux.sockaddr_in (family is 2,
                           port is 443,
                           address is 0xac4293f3)  -- 172.66.147.243  (example.com)

  client.secure_fetch (address is endpoint,
                       host is host,
                       hostlen is 11,
                       request is request,
                       reqlen is 37,
                       sink is page,
                       received is got)

  terminal.write (buffer is page, count is got)

end
