include "../../linux.mereo"
include "../../core.mereo"

-- A loop counter has a FLOOR even when its ceiling is not bound to it. Here the
-- guard reads `i + 4 > n`, so the loop machinery keys the bound on `i + 4` and
-- `i` itself gets none -- and `loop_lo`, which knows the counter entered at
-- zero, was only ever asked when the ceiling was already bound. Without the
-- floor the index has no lower end, and an access under it cannot be told apart
-- from one that reads BEFORE its buffer.
program goes
  buf is 64 bytes
  n is 0
  i is 0
  d is 0
  got is 0
  input is already linux.file (descriptor is 0)
  terminal is already linux.file (descriptor is 1)
  input.read (buffer is buf, capacity is 64, count is got)
  n is got
  walk goes
    leave walk when i + 4 > n
    d is d + [buf + i : 4]
    i is i + 4
    repeat walk
  end
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
