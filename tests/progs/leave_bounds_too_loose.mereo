include "../../linux.mereo"
include "../../core.mereo"

-- The planted violation for the same machinery: the `leave` bounds `n` at 100
-- and the buffer is fifty bytes, so the guard is real and still not enough.
-- Reading a `leave` as a fact has to make this MORE decidable, not less.
program goes
  buf is 50 bytes
  data is 200 bytes
  n is 0
  got is 0
  d is 0
  input is already linux.file (descriptor is 0)
  terminal is already linux.file (descriptor is 1)
  input.read (buffer is data, capacity is 200, count is got)
  n is got
  leave program when n > 100
  d is [buf + n : 1]
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
