include "../../linux.mereo"
include "../../core.mereo"

-- The inner loop runs to `n`, which is what `read` filled, and the kernel's
-- promise `n <= 64` is the only thing that gives it a trip count. Nothing in
-- the C says it: a syscall is inline assembly with a "memory" clobber, and a
-- clobber says SOMETHING changed, not at most this many bytes.
--
-- So this program must KEEP its assume. Dropping it was measured at 200,000
-- instructions on a loop like this one.
program goes
  buf is 64 bytes
  i is 0
  n is 0
  d is 0
  input is already linux.file (descriptor is 0)
  terminal is already linux.file (descriptor is 1)
  input.read (buffer is buf, capacity is 64, count is n)
  walk goes
    leave walk when i >= n
    d is d + [buf + i : 1]
    i is i + 1
    repeat walk
  end
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
