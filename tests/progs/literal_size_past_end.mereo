include "../../linux.mereo"
include "../../core.mereo"

-- The twin, and the proof the size is really being read: the literal is
-- longer than the buffer, so the same loop walks past the end of `small` and
-- the bound that says so is the literal's own length.
program goes
  small is 16 bytes
  i is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  walk goes
    leave walk when i >= "a string that is definitely longer than sixteen".size
    d is d + [small + i : 1]
    i is i + 1
    repeat walk
  end
  [small : 1] is d
  terminal.write (buffer is small, count is 1)
end
