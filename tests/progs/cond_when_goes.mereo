include "../../linux.mereo"

-- REFUSED: a conditional scope is `GUARD goes` and carries no `when`. To take
-- one path or the other, `leave` the enclosing scope at the end of the body --
-- what follows is the other path, which is the `else`.
program (arguments) goes
  n is arguments.count
  buf is 8 bytes
  k is 0
  pick when n == 1 goes
    k is 1
  end
  [buf + 0 : 1] is 48 + k
end
