include "../../linux.mereo"

-- REFUSED: `LABEL when GUARD goes` is a crossroad ROAD, which may only follow
-- its own `LABEL likely goes`. A conditional scope carries no `when`.
program (arguments) goes
  n is arguments.count
  buf is 8 bytes
  k is 0
  pick when n == 1 goes
    k is 1
  end
  [buf + 0 : 1] is 48 + k
end
