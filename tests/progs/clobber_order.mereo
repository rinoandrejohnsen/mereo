include "../../linux.mereo"

-- Adversarial: the byte written to the kernel must be the one stored BEFORE the
-- syscall. Overwriting it immediately after is a dead store only if the syscall
-- cannot read it -- so a clobber that is too narrow makes the first store vanish
-- and the kernel sees the wrong byte.
program goes
  msg is 1 bytes
  screen is already linux.file (descriptor is 1)
  [msg : 1] is 65
  screen.write (buffer is msg, count is 1)
  [msg : 1] is 66
end
