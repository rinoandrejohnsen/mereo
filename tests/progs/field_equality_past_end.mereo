include "../../linux.mereo"
include "../../core.mereo"

-- `leave ... when A != B` says A == B afterwards, which is TWO bounds, and here
-- A is a FIELD (`v.length`) rather than a scalar. Both halves were missing:
-- `!=` contributed no fact at all, and a load returned its own width from `iv`
-- without ever passing through `tighten`, so nothing learned about a field
-- could narrow it. This is the shape a primitive's early-out has -- `equals`
-- returns before reading when the lengths differ, and until this worked, an
-- `equals` written in mereo REFUSED correct programs.
program goes
  buf is 10 bytes
  txt is 40 bytes
  d is 0
  terminal is already linux.file (descriptor is 1)
  v is already span (data is txt, length is 20)
  check goes
    leave check when v.length != 20
    d is d + [buf + v.length : 1]
  end
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
