include "../../linux.mereo"

-- A DEFINITION written inside something that is not a namespace.
--
-- The two used to be the same line. `rec is` and `acquire is` were spelled
-- identically and which one you got depended on what enclosed it, so the parser
-- took `rec` for a no-parameter method whose body declared a local. Nothing
-- called it, and a procedure method was otherwise checked only when it was
-- INLINED -- so nothing ever looked at it again, and the complaint arrived at
-- the USE:
--
--   h is buf as grp.rec
--   ^  mereoc: error: `as` needs a view (signed/unsigned/big/little/...)
--
-- naming neither the nesting nor the group.
--
-- The keyword decides now. A method RUNS, so it opens with `goes`; `rec is` is
-- therefore not a method, and the refusal lands on the declaration.
--
-- Note what is NOT an error: a block holding a definition and a template is a
-- NAMESPACE, and `tests/progs/namespace_template` is exactly that. What makes
-- `holder` below a definition rather than a namespace is its FIELD -- a
-- namespace has members, not bytes -- so the definition inside it has nowhere
-- to live.
--
--   refused:  `rec is` inside 'holder' -- a method runs, so it opens with `goes`

holder is
  tag is 1 bytes                     -- a field: so this is a view, not a
                                     -- namespace, and `rec` has nowhere to go
  rec is
    other is 1 bytes
  end

  go (value) goes
    value is 7
  end
end

program goes
  n is 0

  buf is 8 bytes
  h is buf as holder

  h.go (value is n)

  ensure n == 7
end
