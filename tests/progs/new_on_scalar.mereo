include "../../linux.mereo"

-- `new NAME is VALUE` declared a scalar in 0.2 and said the name was meant to
-- be fresh. It is gone: one word doing one job, and a scalar that wants to be
-- fresh says so by having a name nothing else uses. `new` now means a fresh
-- zeroed INSTANCE -- `NAME is new CLASS` -- which is what `blank` used to say.
--
-- Kept as a refusal so anyone carrying 0.2 code gets told where it went.
program goes
  room is 32 bytes
  page is already builder (data is room, count is 0, limit is 32)
  screen is already linux.file (descriptor is 1)
  got is 0
  s goes
    new v is 5
    got is v
  end
  page.number (value is got)
  page.byte (value is 10)
  screen.write (buffer is page.data, count is page.count)
end
