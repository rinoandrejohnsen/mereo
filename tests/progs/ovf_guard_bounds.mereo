include "../../linux.mereo"
include "../../core.mereo"

-- A guard is evaluated by the MACHINE, not by arithmetic. Here `i + j` is
-- 2**63, which no signed long holds: in arithmetic the guard is true and the
-- program leaves, on the machine the sum is negative and it walks straight on
-- with `k` at -2**63.
--
-- The analysis reasons in whole numbers, and for `+`, `-` and `*` that is
-- exactly right -- two's complement agrees with it modulo 2**64, so an
-- intermediate that wraps and comes back lands on the same value. A
-- COMPARISON is where it stops.
--
-- What made this dangerous rather than merely imprecise: believing the guard
-- gave `i + j` the range (2**63, 100) -- lower bound ABOVE the upper one, an
-- empty range, a contradiction. Only the upper half was read, so it passed as
-- "at most 100" and the access was proved. This binary dumped core.
program goes
  small is 128 bytes
  i is 4611686018427387904
  j is 4611686018427387904
  k is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  leave program when i + j > 100
  k is i + j
  d is [small + k : 1]
  [small : 1] is d
  terminal.write (buffer is small, count is 1)
end
