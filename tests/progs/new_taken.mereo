include "../../linux.mereo"

-- `NAME is VALUE` opens the name if nothing has and assigns it if something
-- has, and nothing in the line says which. `new` says which. Here `v` is
-- already the program's, so a scope asking for one of its own is refused
-- rather than quietly assigning the outer one.

program goes
  w is 8 bytes
  v is 1
  s goes
    new v is 5
    [w + 0 : 8] is v
  end
end
