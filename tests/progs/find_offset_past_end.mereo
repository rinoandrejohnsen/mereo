include "../../linux.mereo"
include "../../core.mereo"

-- `rel` is where `find` stopped, so it can be anything up to the length it was
-- given -- 512 here -- and indexing sixteen bytes with it is out of range for
-- almost all of that. It is accepted in SILENCE, and the reason is exact: the
-- reaching-definition map is built from `assign` steps only, so a call writing
-- its out port never kills what the name held. `rel is 0` is still believed.
--
-- Not wired into blackbox.sh: it does not pass yet. See todo.md.
program goes
  small is 16 bytes
  line is 512 bytes
  rel is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  text.find (data is line, length is 512, byte is 32, offset is rel)
  d is [small + rel : 1]
  [small : 1] is d
  terminal.write (buffer is small, count is 1)
end
