include "../../linux.mereo"
include "../../core.mereo"

-- A STORE indexed by a count the kernel returned. `read` promises only
-- `count <= capacity`, so `n` is 0..64 and every index above 15 is past the
-- end of `small`. The identical LOAD is refused with the exact byte count;
-- this one is accepted in silence, which is the hole this case exists to hold
-- open. See todo.md -- it is NOT fixed, and this file is the reproduction.
program goes
  small is 16 bytes
  data is 64 bytes
  n is 0
  input is already linux.file (descriptor is 0)
  input.read (buffer is data, capacity is 64, count is n)
  [small + n : 1] is 65
end
