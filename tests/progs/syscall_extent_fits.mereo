include "../../linux.mereo"
include "../../core.mereo"

-- The fitting twin of syscall_extent_scalar: same shape, a buffer that is
-- big enough, and it must stay silent -- an extent stated as an access must not
-- become a false positive on every read.
-- The SAME overrun `syscall_fit` catches, with the capacity in a scalar instead
-- of a literal. `check_call_fit` only ever decided the literal case -- it says
-- so -- and this one passed in SILENCE: the kernel writing up to 4096 bytes
-- into sixteen.
--
-- It is caught now because the extent a call writes is stated as an ORDINARY
-- ACCESS after the splice, so intervals apply to it like anything else. One
-- analysis rather than a second one that only works on constants.
program goes
  small is 8192 bytes
  seed is 8 bytes
  cap is 0
  got is 0
  n is 0
  input is already linux.file (descriptor is 0)
  input.read (buffer is seed, capacity is 8, count is n)
  cap is n * 512
  leave program when cap > 4096
  input.read (buffer is small, capacity is cap, count is got)
end
