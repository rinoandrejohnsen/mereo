include "../../linux.mereo"
include "../../core.mereo"

-- The same read, and the promise bounds `n` -- but no branch here asks about
-- `n` at all: the loop runs to a constant. An assume nothing can use is not
-- free, it is a hint the optimiser weighs: loglyze carried six, executed
-- 10,995 more instructions for them, and came out 581 bytes SMALLER because
-- GCC had changed its inlining and lost.
program goes
  buf is 64 bytes
  i is 0
  n is 0
  d is 0
  input is already linux.file (descriptor is 0)
  terminal is already linux.file (descriptor is 1)
  input.read (buffer is buf, capacity is 64, count is n)
  walk goes
    leave walk when i >= 64
    d is d + [buf + i : 1]
    i is i + 1
    repeat walk
  end
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
