include "../../linux.mereo"
include "../../core.mereo"

-- The twin of store_outport_past_end, one character different: this READS
-- where that one WRITES. This is refused, naming the 64 the index reaches.
program goes
  small is 16 bytes
  data is 64 bytes
  n is 0
  d is 0
  input is already linux.file (descriptor is 0)
  terminal is already linux.file (descriptor is 1)
  input.read (buffer is data, capacity is 64, count is n)
  d is [small + n : 1]
  [small : 1] is d
  terminal.write (buffer is small, count is 1)
end
