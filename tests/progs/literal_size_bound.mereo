include "../../linux.mereo"
include "../../core.mereo"

-- `"hello".size` is 5, and the emitter has always said so -- it comes out as
-- a literal 5. The ANALYSIS did not: `size_name` resolved `X.size` only where
-- X was a buffer or an instance, so a bound written against a literal's size
-- bounded nothing at all.
--
-- That matters wherever a template is spliced with a literal for a length:
-- `leave words when "name".size < 8` is what stops a word-at-a-time compare
-- reading eight bytes of a four-byte key, and it said nothing.
program goes
  small is 16 bytes
  i is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  walk goes
    leave walk when i >= "hello".size
    d is d + [small + i : 1]
    i is i + 1
    repeat walk
  end
  [small : 1] is d
  terminal.write (buffer is small, count is 1)
end
