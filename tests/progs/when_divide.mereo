include "../../linux.mereo"

-- REJECTED on purpose, and for the same reason as when_speculative.mereo: a
-- conditional move computes BOTH arms, so `branchless` here divides before
-- testing the divisor. `#DE` is as fatal as `#PF` -- run under the old lowering
-- with y = 0 this died with SIGFPE (exit 136), because the quotient was handed
-- to the asm as an ordinary input operand.
--
-- `x / 4` would be fine: a non-zero literal divisor cannot trap. So would the
-- same line without `branchless`, which branches.
program is
  raw is 16 bytes
  n is 0
  y is 0
  x is 100

  input is already linux.file (descriptor is 0)
  input.read (buffer is raw, capacity is 8, count is n)

  y is [raw + 0 : 8]
  x is x / y when y != 0 branchless
  ensure x >= 0
end
