include "../../../linux.mereo"

-- the ceiling is past the buffer
program goes
  buf is 16 bytes
  i is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  walk goes
    leave walk when i >= 24
    d is d + [buf + i : 1]
    i is i + 1
    repeat walk
  end
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
