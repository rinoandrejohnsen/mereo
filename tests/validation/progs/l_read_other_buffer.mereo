include "../../../linux.mereo"
include "../../../core.mereo"

-- the promise bounds the count by the buffer it FILLED,
-- which says nothing about the smaller one it is then used to index
program goes
  buf is 64 bytes
  small is 8 bytes
  n is 0
  d is 0
  input is already linux.file (descriptor is 0)
  terminal is already linux.file (descriptor is 1)
  input.read (buffer is buf, capacity is 64, count is n)
  d is [small + n : 1]
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
