include "../../../linux.mereo"

-- SOUNDNESS for the back-edge narrowing, and the case that decides how far it
-- may narrow. `k` is 40 at the body's own depth and 4 inside a nested scope
-- that may not run. So `k` is 40 OR 4 at the access, and 40 is past eight
-- bytes: this must be refused.
--
-- Keeping only the LAST definition before the back edge would keep `k is 4`,
-- lose `k is 40`, and prove an access that runs off the end. The rule keeps
-- everything from the last UNCONDITIONAL definition onward, so both survive.
program goes
  small is 8 bytes
  k is 0
  n is 0
  c is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  c is [small + 0 : 1]
  walk goes
    leave walk when n >= 4
    k is 40
    pick goes
      leave pick when c > 200
      k is 4
    end
    d is d + [small + k : 1]
    n is n + 1
    repeat walk
  end
  [small : 1] is d
  terminal.write (buffer is small, count is 1)
end
