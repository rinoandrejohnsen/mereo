include "../../../linux.mereo"

-- `leave words when n < 8` with n a constant 4 reads `4 < 8`:
-- the scope is left every time and its body never runs. The body holds an
-- offset of -4, which is not something the programmer can be asked to bound,
-- because it cannot happen.
program goes
  small is 4 bytes
  n is 4
  d is 0
  terminal is already linux.file (descriptor is 1)
  words goes
    leave words when n < 8
    d is [small + n - 8 : 1]
  end
  [small : 1] is d
  terminal.write (buffer is small, count is 1)
end
