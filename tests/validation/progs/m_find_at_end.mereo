include "../../../linux.mereo"
include "../../../core.mereo"

-- the same offset used WITHOUT that check: when the byte is
-- absent `find` answers 32, and byte 32 of a 32-byte buffer is past the end.
program goes
  buf is 32 bytes
  n is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  text.find (data is buf, length is 32, byte is 10, offset is n)
  d is [buf + n : 1]
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
