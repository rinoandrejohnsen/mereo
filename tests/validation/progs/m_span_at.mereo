include "../../../linux.mereo"
include "../../../core.mereo"

-- reading one byte through the view, at an offset it bounds
program goes
  buf is 32 bytes
  b is 0
  terminal is already linux.file (descriptor is 1)
  v is already span (data is buf, length is 32)
  v.at (offset is 31, byte is b)
  [buf : 1] is b
  terminal.write (buffer is buf, count is 1)
end
