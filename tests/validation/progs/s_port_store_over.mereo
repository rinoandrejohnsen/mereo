include "../../../linux.mereo"

-- the same template, told to paint past the end. Nothing
-- is READ here: `copy` is caught because its right-hand side reads the source,
-- and a template that only writes has no such side.
paint (area, extent, value) goes
  i is 0
  step goes
    leave step when i >= extent
    [area + i : 1] is value
    i is i + 1
    repeat step
  end
end

program goes
  buf is 32 bytes
  terminal is already linux.file (descriptor is 1)
  paint (area is buf, extent is 48, value is 65)
  terminal.write (buffer is buf, count is 32)
end
