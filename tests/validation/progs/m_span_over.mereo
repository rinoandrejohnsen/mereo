include "../../../linux.mereo"
include "../../../core.mereo"

-- a span that claims more bytes than its backing has
program goes
  buf is 32 bytes
  n is 0
  terminal is already linux.file (descriptor is 1)
  v is already span (data is buf, length is 64)
  v.find (byte is 10, offset is n)
  terminal.write (buffer is buf, count is 1)
end
