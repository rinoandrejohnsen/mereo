include "../../../linux.mereo"
include "../../../core.mereo"

-- a json reader over a constant document
program goes
  raw is constant "{\"a\":\"hi\"}"
  start is 0
  vlen is 0
  terminal is already linux.file (descriptor is 1)
  doc is already json (content is raw, length is raw.size)
  doc.text (key is "a", keylen is "a".size, start is start, vlen is vlen)
  field is raw + start
  terminal.write (buffer is field, count is vlen)
end
