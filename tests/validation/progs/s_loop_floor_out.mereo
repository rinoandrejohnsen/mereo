include "../../../linux.mereo"

-- descending from past the end
program goes
  buf is 16 bytes
  i is 24
  d is 0
  terminal is already linux.file (descriptor is 1)
  walk goes
    leave walk when i <= 0
    i is i - 1
    d is d + [buf + i : 1]
    repeat walk
  end
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
