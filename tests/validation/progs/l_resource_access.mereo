include "../../../linux.mereo"
include "../../../core.mereo"

-- an OWNED resource: the release tower runs on every path,
-- and the access inside it is bounded by what the read promised
program goes
  buf is 64 bytes
  n is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  source is linux.file (path is "linux.mereo", flags is 0, mode is 0)
  source.read (buffer is buf, capacity is 64, count is n)
  leave program when n <= 0
  d is [buf + n - 1 : 1]
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
