include "../../../linux.mereo"
include "../../../core.mereo"

-- a loop walking exactly what a read filled
program goes
  buf is 64 bytes
  n is 0
  i is 0
  d is 0
  input is already linux.file (descriptor is 0)
  terminal is already linux.file (descriptor is 1)
  input.read (buffer is buf, capacity is 64, count is n)
  walk goes
    leave walk when i >= n
    d is d + [buf + i : 1]
    i is i + 1
    repeat walk
  end
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
