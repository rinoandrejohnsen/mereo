include "../../../linux.mereo"
include "../../../core.mereo"

-- measure answers a length no greater than its limit, checked here
program goes
  buf is 32 bytes
  n is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  text.measure (data is buf, limit is 32, result is n)
  leave program when n >= 32
  d is [buf + n : 1]
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
