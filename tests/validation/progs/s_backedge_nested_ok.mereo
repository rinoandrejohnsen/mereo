include "../../../linux.mereo"

-- The twin: the nested value is IN RANGE, so the same shape proves. Without
-- this the test above would pass by refusing everything.
program goes
  small is 8 bytes
  k is 0
  n is 0
  c is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  c is [small + 0 : 1]
  walk goes
    leave walk when n >= 4
    k is 0
    pick goes
      leave pick when c > 200
      k is 4
    end
    d is d + [small + k : 1]
    n is n + 1
    repeat walk
  end
  [small : 1] is d
  terminal.write (buffer is small, count is 1)
end
