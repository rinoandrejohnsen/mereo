include "../../../linux.mereo"
include "../../../core.mereo"

-- the offset is bounded by the buffer it was found in,
-- not by the smaller one it is then used to index
program goes
  buf is 32 bytes
  small is 8 bytes
  n is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  text.find (data is buf, length is 32, byte is 10, offset is n)
  d is [small + n : 1]
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
