include "../../../linux.mereo"

-- the twin that READS instead, for the contrast
peek (area, extent, total) goes
  i is 0
  step goes
    leave step when i >= extent
    total is total + [area + i : 1]
    i is i + 1
    repeat step
  end
end

program goes
  buf is 32 bytes
  d is 0
  terminal is already linux.file (descriptor is 1)
  peek (area is buf, extent is 48, total is d)
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
