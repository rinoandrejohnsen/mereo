include "../../../linux.mereo"
include "../../../core.mereo"

-- a span laid over what a read actually filled
program goes
  buf is 64 bytes
  n is 0
  off is 0
  input is already linux.file (descriptor is 0)
  terminal is already linux.file (descriptor is 1)
  input.read (buffer is buf, capacity is 64, count is n)
  leave program when n < 0
  v is already span (data is buf, length is n)
  v.find (byte is 10, offset is off)
  terminal.write (buffer is buf, count is 1)
end
