include "../../../linux.mereo"

-- a DESCENDING counter: the floor is what keeps it in range
program goes
  buf is 16 bytes
  i is 16
  d is 0
  terminal is already linux.file (descriptor is 1)
  walk goes
    leave walk when i <= 0
    i is i - 1
    d is d + [buf + i : 1]
    repeat walk
  end
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
