include "../../../linux.mereo"

-- the same shape where the constant makes it FALSE: `12 < 8` does not fire,
-- the body DOES run, and the access in it is plainly past four bytes. The
-- rule must not blanket a scope just for having a `leave` in it.
program goes
  small is 4 bytes
  d is 0
  terminal is already linux.file (descriptor is 1)
  words goes
    leave words when "hello world!".size < 8
    d is [small + 9 : 1]
  end
  [small : 1] is d
  terminal.write (buffer is small, count is 1)
end
