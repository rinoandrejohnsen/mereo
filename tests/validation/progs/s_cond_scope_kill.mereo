include "../../../linux.mereo"

-- No loop at all. `k` is 40, then 4 inside a scope with a `leave` in it, so at
-- the access it is 40 OR 4 -- and 40 is past eight bytes.
--
-- Taking the NEAREST definition alone answered 4 and proved it. mereoc
-- accepted this in silence and CBMC found the dereference. A definition kills
-- the earlier ones only where every path to the use runs it, which is exactly
-- "no scope containing it closed first".
program goes
  small is 8 bytes
  k is 0
  c is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  c is [small + 0 : 1]
  k is 40
  pick goes
    leave pick when c > 200
    k is 4
  end
  d is [small + k : 1]
  [small : 1] is d
  terminal.write (buffer is small, count is 1)
end
