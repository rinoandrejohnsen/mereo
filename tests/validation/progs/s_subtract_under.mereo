include "../../../linux.mereo"

-- the same subtraction with nothing keeping k at eight or more
program goes
  buf is 16 bytes
  k is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  d is [buf + 0 : 1]
  k is d
  leave program when k > 16
  d is [buf + k - 8 : 1]
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
