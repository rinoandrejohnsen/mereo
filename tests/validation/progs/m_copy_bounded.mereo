include "../../../linux.mereo"
include "../../../core.mereo"

-- text.copy with a length both buffers can take
program goes
  src is 16 bytes
  dst is 32 bytes
  terminal is already linux.file (descriptor is 1)
  text.copy (source is src, target is dst, length is 16)
  terminal.write (buffer is dst, count is 16)
end
