include "../../../linux.mereo"

-- the bound is stated in an OUTER scope and used in an inner one
program goes
  buf is 16 bytes
  i is 0
  j is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  outer goes
    leave outer when i >= 8
    inner goes
      leave inner when j >= 8
      d is d + [buf + i + j : 1]
      j is j + 1
      repeat inner
    end
    i is i + 1
    repeat outer
  end
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
