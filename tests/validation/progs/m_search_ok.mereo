include "../../../linux.mereo"
include "../../../core.mereo"

-- search answers the length when the needle is absent, checked
program goes
  hay is 64 bytes
  n is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  text.search (data is hay, length is 64, needle is "key",
               needle_length is "key".size, offset is n)
  leave program when n >= 64
  d is [hay + n : 1]
  [hay : 1] is d
  terminal.write (buffer is hay, count is 1)
end
