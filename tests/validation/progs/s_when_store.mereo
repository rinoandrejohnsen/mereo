include "../../../linux.mereo"

-- a conditional store, with the index bounded either way
program goes
  buf is 16 bytes
  i is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  d is [buf + 0 : 1]
  i is 4 when d > 0
  d is [buf + i : 1]
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
