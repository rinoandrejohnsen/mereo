include "../../../linux.mereo"
include "../../../core.mereo"

-- the same, indexing past what the read could have filled
program goes
  buf is 64 bytes
  small is 8 bytes
  n is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  source is linux.file (path is "linux.mereo", flags is 0, mode is 0)
  source.read (buffer is buf, capacity is 64, count is n)
  d is [small + n : 1]
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
