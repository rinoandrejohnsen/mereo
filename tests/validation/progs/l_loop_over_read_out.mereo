include "../../../linux.mereo"
include "../../../core.mereo"

-- the same loop, walking eight bytes at a time without
-- room for the last of them
program goes
  buf is 64 bytes
  n is 0
  i is 0
  d is 0
  input is already linux.file (descriptor is 0)
  terminal is already linux.file (descriptor is 1)
  input.read (buffer is buf, capacity is 64, count is n)
  walk goes
    leave walk when i >= n
    d is d + [buf + i : 8]
    i is i + 8
    repeat walk
  end
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
