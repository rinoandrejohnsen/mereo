include "../../../linux.mereo"
include "../../../core.mereo"

-- a builder filling the tail of a buffer a read began
program goes
  buf is 64 bytes
  n is 0
  input is already linux.file (descriptor is 0)
  terminal is already linux.file (descriptor is 1)
  input.read (buffer is buf, capacity is 32, count is n)
  page is already builder (data is buf, count is 32, limit is 64)
  page.add (source is "tail", length is "tail".size)
  terminal.write (buffer is buf, count is 36)
end
