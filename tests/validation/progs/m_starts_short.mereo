include "../../../linux.mereo"
include "../../../core.mereo"

-- `starts` on a view SHORTER than the needle. It handed `text.equals` a length
-- of `other_length` and only zeroed the ANSWER afterwards, so sixteen bytes
-- were read out of an eight-byte buffer before the answer was fixed. mereoc
-- refused that, correctly. Ruling the short case out FIRST makes it both
-- correct and provable, and costs one instruction on the only corpus program
-- that calls either.
program goes
  buf is 8 bytes
  r is 0
  terminal is already linux.file (descriptor is 1)
  v is already span (data is buf, length is 4)
  v.starts (other is "0123456789abcdef", other_length is 16, result is r)
  [buf : 1] is r
  terminal.write (buffer is buf, count is 1)
end
