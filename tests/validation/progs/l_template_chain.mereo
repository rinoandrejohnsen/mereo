include "../../../linux.mereo"
include "../../../core.mereo"

-- a promise carried through TWO splices: `find` bounds the
-- offset, a template passes it on, and the access is at the far end
narrow (area, extent, spot) goes
  text.find (data is area, length is extent, byte is 10, offset is spot)
end

pick (area, extent, value) goes
  spot is 0
  narrow (area is area, extent is extent, spot is spot)
  leave pick when spot >= extent
  value is [area + spot : 1]
end

program goes
  buf is 32 bytes
  d is 0
  terminal is already linux.file (descriptor is 1)
  pick (area is buf, extent is 32, value is d)
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
