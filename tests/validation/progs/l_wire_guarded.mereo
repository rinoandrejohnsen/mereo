include "../../../linux.mereo"
include "../../../core.mereo"

-- a value off the wire, guarded before it is used as an index
program goes
  buf is 64 bytes
  small is 16 bytes
  n is 0
  k is 0
  d is 0
  input is already linux.file (descriptor is 0)
  terminal is already linux.file (descriptor is 1)
  input.read (buffer is buf, capacity is 64, count is n)
  k is [buf + 0 : 1]
  leave program when k >= 16
  d is [small + k : 1]
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
