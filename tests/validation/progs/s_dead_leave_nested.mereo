include "../../../linux.mereo"

-- the `leave` is inside a NESTED scope, so it fires only
-- if that scope is entered. What follows it in the outer one is not dead, and
-- the access there is past the end.
program goes
  small is 4 bytes
  n is 4
  k is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  d is [small + 0 : 1]
  k is d
  words goes
    inner goes
      leave inner when k > 200
      leave words when n < 8
    end
    d is [small + 9 : 1]
  end
  [small : 1] is d
  terminal.write (buffer is small, count is 1)
end
