include "../../../linux.mereo"

-- a template that only STORES, with the length the caller gave
paint (area, extent, value) goes
  i is 0
  step goes
    leave step when i >= extent
    [area + i : 1] is value
    i is i + 1
    repeat step
  end
end

program goes
  buf is 32 bytes
  terminal is already linux.file (descriptor is 1)
  paint (area is buf, extent is 32, value is 65)
  terminal.write (buffer is buf, count is 32)
end
