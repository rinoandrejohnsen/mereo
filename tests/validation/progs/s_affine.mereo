include "../../../linux.mereo"

-- an affine index: i * 4 with i under 4 stays inside 16 bytes
program goes
  buf is 16 bytes
  i is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  walk goes
    leave walk when i >= 4
    d is d + [buf + i * 4 : 4]
    i is i + 1
    repeat walk
  end
  [buf : 1] is d
  terminal.write (buffer is buf, count is 1)
end
