include "../../../linux.mereo"
include "../../../core.mereo"

-- text.number reads digits within the length it is given
program goes
  buf is 16 bytes
  v is 0
  digits is 20 bytes
  n is 0
  terminal is already linux.file (descriptor is 1)
  text.number (data is buf, length is 16, value is v)
  text.format (value is v, buffer is digits, length is n)
  terminal.write (buffer is digits, count is n)
end
