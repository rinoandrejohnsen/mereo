include "../../../linux.mereo"
include "../../../core.mereo"

-- A masked index that is also INCREMENTED in the loop. `hidx` is masked on
-- entry and re-masked on the back edge, so it is 0..7 on every path and
-- `hidx * 4` is 0..28 into a 32-byte table. Proved when the mask is straight
-- line; lost the moment the value comes round a loop.
--
-- This is loglyze's hash probe in twenty lines: twelve of its warnings are
-- this one shape, and Frama-C's Eva proves all twelve.
slot_mask is 7
program goes
  table is 32 bytes
  h is 0
  hidx is 0
  four is 0
  n is 0
  d is 0
  terminal is already linux.file (descriptor is 1)
  h is [table + 0 : 4]
  hidx is h & slot_mask
  walk goes
    leave walk when n >= 8
    four is hidx * 4
    d is d + [table + four : 4]
    hidx is hidx + 1
    hidx is hidx & slot_mask
    n is n + 1
    repeat walk
  end
  [table : 1] is d
  terminal.write (buffer is table, count is 1)
end
