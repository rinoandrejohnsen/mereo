include "../../../linux.mereo"

-- Two syscalls and the checks between them. `read`'s contract is `count >= 0`;
-- `write`'s is that every byte moved.

program goes
  buffer is 4096 bytes
  count is 0

  input is already linux.file (descriptor is 0)

  terminal is already linux.file (descriptor is 1)

  input.read (buffer is buffer, capacity is 4096, count is count)

  terminal.write (buffer is buffer, count is count)

end
