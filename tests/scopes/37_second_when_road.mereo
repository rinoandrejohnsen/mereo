include "markers.mereo"

-- Two guards in a row -- an if / else if / else. The first (n == 5) does not
-- hold, the second (n == 1) does, so the fall-through never runs.
program (arguments) goes
  keep is adopted mark_d (descriptor is 104)
  n is arguments.count
  pick goes
    n == 5 goes
      x is adopted mark_b (descriptor is 102)
      leave pick
    end
    n == 1 goes
      y is adopted mark_c (descriptor is 103)
      leave pick
    end
    h is adopted mark_a (descriptor is 101)
  end
end
