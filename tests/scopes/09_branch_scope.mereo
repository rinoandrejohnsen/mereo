include "markers.mereo"

-- A resource acquired inside a conditional scope belongs to that scope: it must
-- release when the scope ends, like a C++ block. n=1 so the guarded path is not
-- taken and the fall-through -- the `else` -- runs. Expect close(101) close(103).
program (arguments) goes
  keep is adopted mark_c (descriptor is 103)
  n is arguments.count
  -- 1 when run bare, and unknowable at compile time, so the branch survives
  -- into the binary instead of folding away. With a constant guard the
  -- compiler decides it and there is no branch left to test.
  pick goes
    n == 5 goes
      cold is adopted mark_b (descriptor is 102)
      leave pick
    end
    hot is adopted mark_a (descriptor is 101)
  end
end
