include "markers.mereo"

-- The GUARDED path is the one taken this time (n == 1 holds when run bare), so
-- the fall-through never runs. Expect close(102) close(103).
program (arguments) goes
  keep is adopted mark_c (descriptor is 103)
  n is arguments.count
  pick goes
    n == 1 goes
      cold is adopted mark_b (descriptor is 102)
      leave pick
    end
    hot is adopted mark_a (descriptor is 101)
  end
end
