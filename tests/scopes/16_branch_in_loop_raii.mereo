include "markers.mereo"

-- A branch in a loop: the fall-through adopts `h`, released at the end of the
-- conditional scope on each of 3 iterations; keep at exit. The guard (m=0,
-- never -- argc is 1) is not taken. Expect: 101 101 101 104
program (arguments) goes
  keep is adopted mark_d (descriptor is 104)
  i is 0
  m is arguments.count
  -- 1 when run bare, and unknowable at compile time, so the branch survives.
  serve goes
    pick goes
      m == 0 goes
        c is adopted mark_b (descriptor is 102)
        leave pick
      end
      h is adopted mark_a (descriptor is 101)
    end
    i is i + 1
    repeat serve when i < 3
  end
end
