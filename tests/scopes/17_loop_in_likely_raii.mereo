include "markers.mereo"

-- A loop inside the fall-through path: three adoptions, each released per
-- iteration, then keep. The guard (n=0, never) is not taken.
-- Expect close(101) x3 then close(104).
program (arguments) goes
  keep is adopted mark_d (descriptor is 104)
  n is arguments.count
  k is 0
  pick goes
    n == 0 goes
      c is adopted mark_b (descriptor is 102)
      leave pick
    end
    spin goes
      t is adopted mark_a (descriptor is 101)
      k is k + 1
      repeat spin when k < 3
    end
  end
end
