include "markers.mereo"

-- A fault inside the TAKEN guarded path: its own resource releases first, then
-- keep. The fall-through's resource never existed.
program (arguments) goes
  keep is adopted mark_c (descriptor is 103)
  n is arguments.count
  pick goes
    n == 1 goes
      cold is adopted mark_a (descriptor is 101)
      cold.boom
      leave pick
    end
    hot is adopted mark_b (descriptor is 102)
  end
end
