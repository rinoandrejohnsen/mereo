include "markers.mereo"

-- An early `leave pick` from inside the GUARDED path, skipping what is left of
-- it. Both resources taken before the leave must release; `late` never exists.
program (arguments) goes
  keep is adopted mark_d (descriptor is 104)
  n is arguments.count
  i is 0
  serve goes
    o is adopted mark_c (descriptor is 103)
    pick goes
      i == 1 goes
        c is adopted mark_b (descriptor is 102)
        e is adopted mark_e (descriptor is 105)
        leave pick when n < 9
        late is adopted mark_a (descriptor is 101)
        leave pick
      end
      h is adopted mark_a (descriptor is 101)
    end
    i is i + 1
    repeat serve when i < n + 2
  end
end
