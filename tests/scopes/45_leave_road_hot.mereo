include "markers.mereo"

-- An early `leave pick` from the FALL-THROUGH path: `h` is taken and released,
-- `skipped` never exists.
program (arguments) goes
  keep is adopted mark_d (descriptor is 104)
  n is arguments.count
  i is 0
  serve goes
    o is adopted mark_c (descriptor is 103)
    pick goes
      n == 9 goes
        c is adopted mark_b (descriptor is 102)
        leave pick
      end
      h is adopted mark_a (descriptor is 101)
      leave pick when n < 9
      skipped is adopted mark_b (descriptor is 102)
    end
    i is i + 1
    repeat serve when i < 3
  end
end
